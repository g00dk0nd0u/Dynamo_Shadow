<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0-windows;net10.0-windows</TargetFrameworks>
    <AssemblyName>RevitShadow</AssemblyName>
    <RootNamespace>RevitShadow</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <EnableRevitApi Condition="'$(EnableRevitApi)' == ''">false</EnableRevitApi>
  </PropertyGroup>
  <PropertyGroup Condition="'$(EnableRevitApi)' == 'true'">
    <DefineConstants>$(DefineConstants);REVIT_API</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../core/ShadowCore.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(EnableRevitApi)' == 'true'">
    <Reference Include="RevitAPI">
      <HintPath>$(RevitApiDir)/RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <Target Name="ValidateRevitApiReference" BeforeTargets="ResolveAssemblyReferences" Condition="'$(EnableRevitApi)' == 'true'">
    <Error Condition="'$(RevitApiDir)' == ''" Text="EnableRevitApi=true requires RevitApiDir to name the directory containing RevitAPI.dll." />
    <Error Condition="'$(RevitApiDir)' != '' and !Exists('$(RevitApiDir)/RevitAPI.dll')" Text="EnableRevitApi=true, but RevitAPI.dll was not found under RevitApiDir='$(RevitApiDir)'." />
  </Target>
</Project>
