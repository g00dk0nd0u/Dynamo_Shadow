<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../core/ShadowCore.csproj" />
    <ProjectReference Include="../dynamo/DynamoShadow.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../tests/fixtures/parity/accuracy_presets.json"
          Link="fixtures/parity/accuracy_presets.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../tests/fixtures/parity/forward_vertical_slice_v0.json"
          Link="fixtures/parity/forward_vertical_slice_v0.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../tests/fixtures/parity/forward_projection_v0.json"
          Link="fixtures/parity/forward_projection_v0.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../tests/fixtures/parity/forward_solar_true_north_v0.json"
          Link="fixtures/parity/forward_solar_true_north_v0.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../tests/fixtures/parity/forward_portable_parity_v0.json"
          Link="fixtures/parity/forward_portable_parity_v0.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../tests/fixtures/parity/forward_post_union_v0.json"
          Link="fixtures/parity/forward_post_union_v0.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
