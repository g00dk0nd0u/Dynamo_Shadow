  "Nodes": [
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# Dynamo Python Node / CPython3\n# Emergency checkpoint bootstrap for node-level crash diagnosis.\n\nimport os\n\nLOADER_NAME = \"dynamo_loader.py\"\nNODE_BUILD_ID = \"2026-07-28-python-node-checkpoint-v1\"\n_CHECKPOINT_RELATIVE_PATH = \"debug_logs/runtime_checkpoint.txt\"\ncheckpoint_path = None\nlast_checkpoint = None\n_pending_checkpoints = []\n\n\ndef _safe_checkpoint_text(value):\n    try:\n        text = str(value)\n    except BaseException:\n        text = \"<unavailable>\"\n    text = text.replace(\"\\r\", \" \").replace(\"\\n\", \" \")\n    return text[:160]\n\n\ndef checkpoint(stage, detail=None, reset=False):\n    global last_checkpoint\n    try:\n        safe_stage = _safe_checkpoint_text(stage)\n        safe_detail = None if detail is None else _safe_checkpoint_text(detail)\n        last_checkpoint = safe_stage\n        if checkpoint_path is None:\n            _pending_checkpoints.append((safe_stage, safe_detail, reset))\n            return\n        mode = \"w\" if reset else \"a\"\n        with open(checkpoint_path, mode, encoding=\"utf-8\") as stream:\n            line = safe_stage\n            if safe_detail is not None:\n                line += \" | \" + safe_detail\n            stream.write(line + \"\\n\")\n            stream.flush()\n            os.fsync(stream.fileno())\n    except BaseException:\n        pass\n\n\ndef _flush_pending_checkpoints():\n    global _pending_checkpoints\n    try:\n        pending = list(_pending_checkpoints)\n        _pending_checkpoints = []\n        for stage, detail, reset in pending:\n            checkpoint(stage, detail, reset)\n    except BaseException:\n        pass\n\n\ndef _safe_error_text(exc):\n    try:\n        return _safe_checkpoint_text(exc)\n    except BaseException:\n        return \"<unavailable>\"\n\n\ncheckpoint(\"NODE_ENTER\", reset=True)\ncheckpoint(\"WORKSPACE_RESOLVE_BEFORE\")\n\ntry:\n    import clr\n    clr.AddReference(\"DynamoServices\")\n    from Dynamo.Applications import DynamoRevit\n\n    try:\n        workspace_file = DynamoRevit.RevitDynamoModel.CurrentWorkspace.FileName\n    except BaseException:\n        workspace_file = None\n    workspace_dir = os.path.dirname(workspace_file) if workspace_file else None\n    if workspace_dir:\n        checkpoint_path = os.path.join(workspace_dir, _CHECKPOINT_RELATIVE_PATH)\n        try:\n            os.makedirs(os.path.dirname(checkpoint_path), exist_ok=True)\n        except BaseException:\n            pass\n    _flush_pending_checkpoints()\n    checkpoint(\"WORKSPACE_RESOLVE_AFTER\", \"ok\" if workspace_dir else \"none\")\n    checkpoint(\"NODE_BUILD_ID\", NODE_BUILD_ID)\n    checkpoint(\"CHECKPOINT_FILE_READY\", \"ok\" if checkpoint_path else \"none\")\n\n    checkpoint(\"LOADER_PATH_CHECK_BEFORE\")\n    loader_path = os.path.join(workspace_dir, LOADER_NAME) if workspace_dir else None\n    loader_ready = bool(loader_path and os.path.isfile(loader_path))\n    checkpoint(\"LOADER_PATH_CHECK_AFTER\", \"ok\" if loader_ready else \"failure\")\n\n    if not loader_ready:\n        final_out = {\n            \"success\": False,\n            \"error_code\": \"python_node_bootstrap_failure\",\n            \"error_type\": \"FileNotFoundError\",\n            \"error\": \"dynamo_loader.py not found in the same folder as the .dyn file.\",\n            \"last_checkpoint\": last_checkpoint,\n            \"runtime_checkpoint_file\": _CHECKPOINT_RELATIVE_PATH,\n        }\n    else:\n        checkpoint(\"LOADER_READ_BEFORE\")\n        with open(loader_path, \"r\", encoding=\"utf-8-sig\") as stream:\n            loader_code = stream.read()\n        checkpoint(\"LOADER_READ_AFTER\", \"ok\")\n\n        checkpoint(\"LOADER_COMPILE_BEFORE\")\n        compiled_loader = compile(loader_code, loader_path, \"exec\")\n        checkpoint(\"LOADER_COMPILE_AFTER\", \"ok\")\n        loader_globals = {\n            \"__file__\": loader_path,\n            \"__name__\": \"__dynamo_loader__\",\n            \"IN\": IN,\n            \"OUT\": None,\n            \"WORKSPACE_FILE\": workspace_file,\n            \"WORKSPACE_DIR\": workspace_dir,\n            \"LOADER_PATH\": loader_path,\n            \"RUNTIME_CHECKPOINT\": checkpoint,\n        }\n        try:\n            loader_globals[\"UnwrapElement\"] = UnwrapElement\n        except BaseException:\n            pass\n\n        checkpoint(\"LOADER_EXEC_BEFORE\")\n        exec(compiled_loader, loader_globals)\n        checkpoint(\"LOADER_EXEC_AFTER\", \"ok\")\n        checkpoint(\"LOADER_OUT_READ_BEFORE\")\n        final_out = loader_globals.get(\"OUT\", None)\n        checkpoint(\"LOADER_OUT_READ_AFTER\", \"none\" if final_out is None else (\"dict\" if isinstance(final_out, dict) else \"ok\"))\n\nexcept BaseException as exc:\n    checkpoint(\"NODE_EXCEPTION\", type(exc).__name__)\n    final_out = {\n        \"success\": False,\n        \"error_code\": \"python_node_bootstrap_failure\",\n        \"error_type\": type(exc).__name__,\n        \"error\": _safe_error_text(exc),\n        \"last_checkpoint\": last_checkpoint,\n        \"runtime_checkpoint_file\": _CHECKPOINT_RELATIVE_PATH,\n    }\n\ncheckpoint(\"NODE_OUT_ASSIGN_BEFORE\")\nOUT = final_out\ncheckpoint(\"NODE_RETURN_READY\")\n",
